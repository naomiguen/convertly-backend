PROJECT_NAME="Convertly API"

# Path relatif dihitung dari folder backend/
UPLOAD_FOLDER="../storage/uploads"
RESULT_FOLDER="../storage/results"

MAX_UPLOAD_MB=50
MAX_FILES_PER_UPLOAD=20
MAX_OCR_PAGES=20
FILE_TTL_MINUTES=30

# Pisahkan dengan koma
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Pengaman penyalahgunaan (per IP) ---
RATE_LIMIT_ENABLED=true
# Di belakang reverse proxy (nginx/Cloudflare) isi 1; jika diakses langsung biarkan 0
TRUSTED_PROXY_COUNT=0
RATE_UPLOAD_PER_MIN=20
RATE_PROCESS_COST_PER_MIN=30
RATE_DOWNLOAD_PER_MIN=120
UPLOAD_MB_PER_HOUR=1000
MAX_REQUEST_MB=300
MAX_HEAVY_FILES_PER_REQUEST=5
MAX_CONCURRENT_JOBS=4
MAX_JOBS_PER_IP=2
JOB_QUEUE_TIMEOUT_SECONDS=30
MAX_STORAGE_MB=5000

# --- Redis (opsional): bagikan rate limit & batas pekerjaan antar worker/instance ---
# Kosong = pakai memori proses. Jika Redis tidak terjangkau, otomatis kembali ke memori.
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=convertly
REDIS_TIMEOUT_SECONDS=0.5
REDIS_RETRY_SECONDS=30
JOB_LEASE_SECONDS=1800
